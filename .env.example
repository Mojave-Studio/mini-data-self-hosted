# Cloudflare (from `wrangler whoami` or dashboard)
# CLOUDFLARE_ACCOUNT_ID=

# Mini Data platform (UI + auth — your data plane is still in your Cloudflare account)
MINIDATA_ORIGIN=https://minidata.io

# Your deployed data worker URL (workers.dev or custom domain). Written by `npm run provision`.
# MINIDATA_DATA_URL=https://minidata-self-hosted-data.your-subdomain.workers.dev
# MINIDATA_DATA_URL=https://data.mojavestud.io

# Optional: session cookie from browser after signing in at minidata.io (for CLI register)
# MINIDATA_SESSION_COOKIE=

# Optional overrides
# D1_DATABASE_NAME=mini_data_db
# R2_BUCKET_NAME=minidata-files
