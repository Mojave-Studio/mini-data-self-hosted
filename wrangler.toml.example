# Generated by `npm run provision` — do not commit (see .gitignore)
name = "minidata-self-hosted-data"
compatibility_date = "2024-09-01"
main = "scripts/noop-worker.mjs"

# After deploy, Cloudflare assigns https://minidata-self-hosted-data.<subdomain>.workers.dev
# Optional: attach a custom domain in Workers → Settings → Domains & Routes, e.g. data.mojavestud.io
# Then set MINIDATA_DATA_URL in .env and paste that URL in minidata.io Settings → Self-Hosted Data.

[[d1_databases]]
binding = "DB"
database_name = "mini_data_db"
database_id = "REPLACE_WITH_DATABASE_ID"

# Uncomment after `npm run provision` creates the bucket:
# [[r2_buckets]]
# binding = "FILES_BUCKET"
# bucket_name = "minidata-files"
